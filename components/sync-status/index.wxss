/* 同步状态组件样式 */

.sync-status {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  transform: translateY(-100%);
  transition: transform 0.3s ease;
}

.sync-status.show {
  transform: translateY(0);
}

.status-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  padding-top: calc(16rpx + env(safe-area-inset-top));
}

.status-bar.offline {
  background: linear-gradient(135deg, #636e72 0%, #2d3436 100%);
}

.status-bar.pending {
  background: linear-gradient(135deg, #fdcb6e 0%, #e17055 100%);
}

.status-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.status-icon.syncing {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.status-text {
  flex: 1;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.status-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 16rpx;
}

.sync-btn {
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.sync-btn:active {
  background: rgba(255, 255, 255, 0.5);
}
