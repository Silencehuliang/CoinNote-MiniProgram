/* 成功提示组件 - 温暖治愈风格 */

.success-toast {
  position: fixed;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%) translateY(100rpx);
  background: #FFFFFF;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  box-shadow: 0 16rpx 48rpx rgba(255, 126, 95, 0.2);
  display: flex;
  align-items: center;
  gap: 24rpx;
  opacity: 0;
  transition: all 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 1000;
  border: 3rpx solid #FFE8D0;
}

.success-toast.show {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
}

.success-toast__emoji {
  font-size: 64rpx;
  animation: bounce 0.6s ease infinite;
}

.success-toast__text {
  font-size: 30rpx;
  color: #4A3728;
  font-weight: 500;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}
