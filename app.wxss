/* CoinNote 全局样式 - 遵循微信小程序设计规范 */

/* ==================== 基础样式 ==================== */
page {
  --white: #FFFFFF;
  --black: #000000;
  
  /* 微信标准色板 */
  --color-brand: #07C160;           /* 微信绿 - 主色 */
  --color-brand-light: #38D97A;     /* 浅绿 */
  --color-brand-dark: #06AD56;      /* 深绿 */
  
  /* 功能色 */
  --color-danger: #FA5151;          /* 错误/警告 */
  --color-warning: #FFC300;         /* 警示 */
  --color-success: #07C160;         /* 成功 */
  --color-info: #10AEFF;            /* 信息 */
  
  /* 中性色 - 文字 */
  --color-text-primary: #333333;    /* 主要文字 */
  --color-text-regular: #666666;    /* 次要文字 */
  --color-text-secondary: #999999;  /* 辅助文字 */
  --color-text-placeholder: #CCCCCC;/* 占位文字 */
  
  /* 中性色 - 背景 */
  --color-bg-page: #F6F6F6;         /* 页面背景 */
  --color-bg-card: #FFFFFF;         /* 卡片背景 */
  --color-bg-hover: #F2F2F2;        /* 按下状态 */
  --color-bg-disabled: #F7F7F7;     /* 禁用背景 */
  
  /* 中性色 - 边框 */
  --color-border: #E5E5E5;          /* 边框 */
  --color-divider: #F2F2F2;         /* 分割线 */
  
  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  
  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-round: 999rpx;
  
  /* 字号 - 微信标准 */
  --font-size-xl: 44rpx;           /* 大标题 */
  --font-size-lg: 34rpx;           /* 标题 */
  --font-size-md: 30rpx;           /* 正文 */
  --font-size-sm: 28rpx;           /* 次要文字 */
  --font-size-xs: 24rpx;           /* 辅助文字 */
  --font-size-xxs: 22rpx;          /* 最小文字 */
  
  /* 字重 */
  --font-weight-bold: 600;
  --font-weight-medium: 500;
  --font-weight-regular: 400;
  
  /* 行高 */
  --line-height-tight: 1.3;
  --line-height-normal: 1.5;
  --line-height-relaxed: 1.75;
  
  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  
  /* 基础页面样式 */
  background-color: var(--color-bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
}

/* ==================== 容器 ==================== */
.container {
  padding: var(--spacing-lg);
  min-height: 100vh;
  box-sizing: border-box;
}

.container--white {
  background-color: var(--white);
}

.container--gray {
  background-color: var(--color-bg-page);
}

.container--safe-bottom {
  padding-bottom: calc(var(--spacing-lg) + env(safe-area-inset-bottom));
}

/* ==================== 卡片 ==================== */
.card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  overflow: hidden;
}

.card--shadow {
  box-shadow: var(--shadow-sm);
}

.card--border {
  border: 1rpx solid var(--color-border);
}

.card--flat {
  box-shadow: none;
  border: none;
  background-color: transparent;
}

/* ==================== 按钮 ==================== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  transition: opacity 0.2s, transform 0.1s;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.05);
  opacity: 0;
  transition: opacity 0.2s;
}

.btn:active::after {
  opacity: 1;
}

/* 主按钮 - 微信绿 */
.btn--primary {
  background-color: var(--color-brand);
  color: var(--white);
}

.btn--primary:active {
  background-color: var(--color-brand-dark);
}

/* 次要按钮 */
.btn--secondary {
  background-color: var(--white);
  color: var(--color-brand);
  border: 2rpx solid var(--color-brand);
}

.btn--secondary:active {
  background-color: rgba(7, 193, 96, 0.05);
}

/* 文字按钮 */
.btn--text {
  background-color: transparent;
  color: var(--color-brand);
  height: auto;
  padding: 0;
}

.btn--text:active {
  opacity: 0.6;
}

/* 警告按钮 */
.btn--danger {
  background-color: var(--color-danger);
  color: var(--white);
}

.btn--danger:active {
  background-color: #E04646;
}

/* 幽灵按钮 */
.btn--ghost {
  background-color: transparent;
  color: var(--color-text-regular);
  border: 2rpx solid var(--color-border);
}

.btn--ghost:active {
  background-color: var(--color-bg-hover);
}

/* 块级按钮 */
.btn--block {
  width: 100%;
}

/* 小按钮 */
.btn--small {
  height: 72rpx;
  padding: 0 32rpx;
  font-size: var(--font-size-sm);
  border-radius: var(--radius-sm);
}

/* 迷你按钮 */
.btn--mini {
  height: 56rpx;
  padding: 0 24rpx;
  font-size: var(--font-size-xs);
  border-radius: var(--radius-sm);
}

/* 圆角按钮 */
.btn--round {
  border-radius: var(--radius-round);
}

/* 禁用状态 */
.btn--disabled {
  background-color: var(--color-bg-disabled);
  color: var(--color-text-placeholder);
  border-color: var(--color-border);
}

.btn--disabled:active {
  background-color: var(--color-bg-disabled);
}

/* ==================== 输入框 ==================== */
.input-group {
  margin-bottom: var(--spacing-md);
}

.input-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-regular);
  margin-bottom: var(--spacing-xs);
  font-weight: var(--font-weight-medium);
}

.input {
  width: 100%;
  height: 96rpx;
  padding: 0 var(--spacing-lg);
  background-color: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.input:focus {
  border-color: var(--color-brand);
}

.input--textarea {
  height: 200rpx;
  padding: var(--spacing-md);
  line-height: var(--line-height-normal);
}

.input--error {
  border-color: var(--color-danger);
}

.input-placeholder {
  color: var(--color-text-placeholder);
}

.input-error-text {
  font-size: var(--font-size-xs);
  color: var(--color-danger);
  margin-top: var(--spacing-xs);
}

/* ==================== 列表 ==================== */
.list {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.list-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  position: relative;
  min-height: 112rpx;
  box-sizing: border-box;
}

.list-item::after {
  content: '';
  position: absolute;
  left: var(--spacing-lg);
  right: 0;
  bottom: 0;
  height: 1rpx;
  background-color: var(--color-divider);
}

.list-item:last-child::after {
  display: none;
}

.list-item:active {
  background-color: var(--color-bg-hover);
}

.list-item--disabled {
  opacity: 0.5;
}

.list-item--disabled:active {
  background-color: transparent;
}

.list-item__left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.list-item__right {
  display: flex;
  align-items: center;
  margin-left: var(--spacing-md);
}

.list-item__icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.list-item__icon image {
  width: 100%;
  height: 100%;
}

.list-item__content {
  flex: 1;
  min-width: 0;
}

.list-item__title {
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-item__desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-top: var(--spacing-xs);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-item__arrow {
  width: 32rpx;
  height: 32rpx;
  margin-left: var(--spacing-sm);
  color: var(--color-text-placeholder);
}

.list-item__value {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* ==================== 表单 ==================== */
.form {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
}

.form-item {
  margin-bottom: var(--spacing-lg);
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-regular);
  margin-bottom: var(--spacing-xs);
  font-weight: var(--font-weight-medium);
}

.form-tip {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-top: var(--spacing-xs);
}

.form-error {
  font-size: var(--font-size-xs);
  color: var(--color-danger);
  margin-top: var(--spacing-xs);
}

/* ==================== 标签 ==================== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: var(--spacing-xs) var(--spacing-sm);
  background-color: var(--color-bg-page);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-xs);
  color: var(--color-text-regular);
  margin-right: var(--spacing-xs);
  margin-bottom: var(--spacing-xs);
}

.tag--primary {
  background-color: rgba(7, 193, 96, 0.1);
  color: var(--color-brand);
}

.tag--success {
  background-color: rgba(7, 193, 96, 0.1);
  color: var(--color-success);
}

.tag--warning {
  background-color: rgba(255, 195, 0, 0.1);
  color: var(--color-warning);
}

.tag--danger {
  background-color: rgba(250, 81, 81, 0.1);
  color: var(--color-danger);
}

.tag--info {
  background-color: rgba(16, 174, 255, 0.1);
  color: var(--color-info);
}

.tag--active {
  background-color: var(--color-brand);
  color: var(--white);
}

/* ==================== 徽标 ==================== */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 var(--spacing-xs);
  background-color: var(--color-danger);
  border-radius: var(--radius-round);
  font-size: var(--font-size-xxs);
  color: var(--white);
  font-weight: var(--font-weight-medium);
}

.badge--dot {
  min-width: 16rpx;
  height: 16rpx;
  padding: 0;
}

/* ==================== 分割线 ==================== */
.divider {
  height: 1rpx;
  background-color: var(--color-divider);
  margin: var(--spacing-md) 0;
}

.divider--text {
  display: flex;
  align-items: center;
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
}

.divider--text::before,
.divider--text::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background-color: var(--color-divider);
}

.divider--text::before {
  margin-right: var(--spacing-md);
}

.divider--text::after {
  margin-left: var(--spacing-md);
}

/* ==================== 空状态 ==================== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-xl);
}

.empty__icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: var(--spacing-lg);
  opacity: 0.6;
}

.empty__text {
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: var(--spacing-sm);
}

.empty__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-placeholder);
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

/* ==================== 加载状态 ==================== */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl);
}

.loading__spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading__text {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-top: var(--spacing-md);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ==================== 提示 ==================== */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.7);
  border-radius: var(--radius-md);
  padding: var(--spacing-md) var(--spacing-lg);
  z-index: 1000;
}

.toast__text {
  font-size: var(--font-size-sm);
  color: var(--white);
  text-align: center;
}

/* ==================== 弹窗 ==================== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal__content {
  position: relative;
  width: 80%;
  max-width: 640rpx;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  z-index: 1;
}

.modal__header {
  padding: var(--spacing-lg);
  text-align: center;
}

.modal__title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.modal__body {
  padding: 0 var(--spacing-lg) var(--spacing-lg);
  font-size: var(--font-size-sm);
  color: var(--color-text-regular);
  text-align: center;
  line-height: var(--line-height-relaxed);
}

.modal__footer {
  display: flex;
  border-top: 1rpx solid var(--color-divider);
}

.modal__btn {
  flex: 1;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  position: relative;
}

.modal__btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.05);
  opacity: 0;
  transition: opacity 0.2s;
}

.modal__btn:active::after {
  opacity: 1;
}

.modal__btn--default {
  color: var(--color-text-regular);
}

.modal__btn--primary {
  color: var(--color-brand);
}

.modal__btn--danger {
  color: var(--color-danger);
}

.modal__btn + .modal__btn {
  border-left: 1rpx solid var(--color-divider);
}

/* ==================== 浮动按钮 ==================== */
.fab {
  position: fixed;
  right: var(--spacing-lg);
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  background-color: var(--color-brand);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
  z-index: 100;
  transition: transform 0.2s;
}

.fab:active {
  transform: scale(0.95);
}

.fab__icon {
  font-size: 56rpx;
  color: var(--white);
  font-weight: var(--font-weight-regular);
}

/* ==================== 标签栏 ==================== */
.tab-bar {
  display: flex;
  background-color: var(--color-bg-card);
  border-top: 1rpx solid var(--color-divider);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  position: relative;
}

.tab-item__icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: var(--spacing-xs);
}

.tab-item__text {
  font-size: var(--font-size-xxs);
  color: var(--color-text-secondary);
}

.tab-item--active .tab-item__text {
  color: var(--color-brand);
}

/* ==================== 顶部标签 ==================== */
.tabs {
  display: flex;
  background-color: var(--color-bg-card);
  height: 88rpx;
  position: relative;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-regular);
  position: relative;
}

.tab--active {
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}

.tab--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: var(--color-brand);
  border-radius: 2rpx;
}

/* ==================== 进度条 ==================== */
.progress {
  height: 12rpx;
  background-color: var(--color-bg-page);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress__bar {
  height: 100%;
  background-color: var(--color-brand);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* ==================== 头像 ==================== */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--color-bg-page);
}

.avatar--small {
  width: 56rpx;
  height: 56rpx;
}

.avatar--large {
  width: 120rpx;
  height: 120rpx;
}

.avatar image {
  width: 100%;
  height: 100%;
}

/* ==================== 工具类 ==================== */

/* 文字 */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-left { text-align: left; }

.text-primary { color: var(--color-brand); }
.text-danger { color: var(--color-danger); }
.text-warning { color: var(--color-warning); }
.text-success { color: var(--color-success); }
.text-info { color: var(--color-info); }
.text-regular { color: var(--color-text-regular); }
.text-secondary { color: var(--color-text-secondary); }
.text-placeholder { color: var(--color-text-placeholder); }

.font-bold { font-weight: var(--font-weight-bold); }
.font-medium { font-weight: var(--font-weight-medium); }
.font-regular { font-weight: var(--font-weight-regular); }

.text-xl { font-size: var(--font-size-xl); }
.text-lg { font-size: var(--font-size-lg); }
.text-md { font-size: var(--font-size-md); }
.text-sm { font-size: var(--font-size-sm); }
.text-xs { font-size: var(--font-size-xs); }
.text-xxs { font-size: var(--font-size-xxs); }

/* 间距 */
.mt-xs { margin-top: var(--spacing-xs); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }

.mb-xs { margin-bottom: var(--spacing-xs); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.mb-xl { margin-bottom: var(--spacing-xl); }

.ml-xs { margin-left: var(--spacing-xs); }
.ml-sm { margin-left: var(--spacing-sm); }
.ml-md { margin-left: var(--spacing-md); }
.ml-lg { margin-left: var(--spacing-lg); }

.mr-xs { margin-right: var(--spacing-xs); }
.mr-sm { margin-right: var(--spacing-sm); }
.mr-md { margin-right: var(--spacing-md); }
.mr-lg { margin-right: var(--spacing-lg); }

.pt-xs { padding-top: var(--spacing-xs); }
.pt-sm { padding-top: var(--spacing-sm); }
.pt-md { padding-top: var(--spacing-md); }
.pt-lg { padding-top: var(--spacing-lg); }

.pb-xs { padding-bottom: var(--spacing-xs); }
.pb-sm { padding-bottom: var(--spacing-sm); }
.pb-md { padding-bottom: var(--spacing-md); }
.pb-lg { padding-bottom: var(--spacing-lg); }

.px-sm { padding-left: var(--spacing-sm); padding-right: var(--spacing-sm); }
.px-md { padding-left: var(--spacing-md); padding-right: var(--spacing-md); }
.px-lg { padding-left: var(--spacing-lg); padding-right: var(--spacing-lg); }

.py-sm { padding-top: var(--spacing-sm); padding-bottom: var(--spacing-sm); }
.py-md { padding-top: var(--spacing-md); padding-bottom: var(--spacing-md); }
.py-lg { padding-top: var(--spacing-lg); padding-bottom: var(--spacing-lg); }

/* Flex */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-center { align-items: center; justify-content: center; }
.flex-between { justify-content: space-between; }
.flex-around { justify-content: space-around; }
.flex-start { align-items: flex-start; }
.flex-end { align-items: flex-end; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }
.flex-shrink-0 { flex-shrink: 0; }

/* 圆角 */
.rounded-sm { border-radius: var(--radius-sm); }
.rounded-md { border-radius: var(--radius-md); }
.rounded-lg { border-radius: var(--radius-lg); }
.rounded-full { border-radius: 50%; }

/* 阴影 */
.shadow-sm { box-shadow: var(--shadow-sm); }
.shadow-md { box-shadow: var(--shadow-md); }
.shadow-lg { box-shadow: var(--shadow-lg); }

/* 溢出 */
.overflow-hidden { overflow: hidden; }
.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 隐藏 */
.hidden { display: none; }
.invisible { visibility: hidden; }

/* 定位 */
.relative { position: relative; }
.absolute { position: absolute; }
.fixed { position: fixed; }

/* 尺寸 */
.w-full { width: 100%; }
.h-full { height: 100%; }

/* 动画 */
.fade-in {
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.slide-up {
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
