/* pages/expense/list.wxss */

/* 筛选区域 */
.filter-section {
  margin-bottom: 24rpx;
  padding: 16rpx 0;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 16rpx;
}

.filter-item {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: var(--color-bg);
  border-radius: 4rpx;
  font-size: 24rpx;
}

.filter-item.active {
  background: var(--color-primary);
  color: #FFFFFF;
}

.filter-text {
  margin-right: 8rpx;
}

.filter-arrow {
  font-size: 16rpx;
}

.clear-filter {
  text-align: center;
  padding: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* 日期分组 */
.date-group {
  margin-bottom: 24rpx;
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.date-text {
  font-size: 24rpx;
  color: var(--color-text-muted);
  font-weight: 500;
}

.date-total {
  font-size: 24rpx;
  color: var(--color-text-muted);
  font-feature-settings: "tnum";
}

/* 消费项 */
.expense-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.expense-item:last-child {
  border-bottom: none;
}

.expense-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
  border-radius: 50%;
  margin-right: 24rpx;
}

.icon-emoji {
  font-size: 36rpx;
}

.expense-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.expense-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.expense-category {
  font-size: 28rpx;
  font-weight: 500;
}

.expense-amount {
  font-size: 28rpx;
  font-weight: 500;
  font-feature-settings: "tnum";
}

.expense-sub {
  display: flex;
  align-items: center;
}

.expense-desc {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-right: 16rpx;
}

.expense-user {
  font-size: 20rpx;
  color: var(--color-text-muted);
  padding: 2rpx 12rpx;
  background: var(--color-bg);
  border-radius: 4rpx;
}

/* 加载完成 */
.load-end {
  padding: 32rpx;
  text-align: center;
}

.load-end-text {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* 选择器弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.picker-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: 64rpx;
  max-height: 80vh;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 500;
}

.picker-close {
  font-size: 32rpx;
  color: var(--color-text-muted);
  padding: 16rpx;
}

/* 日期范围 */
.date-range {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.date-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 48rpx;
  background: var(--color-bg);
  border-radius: 8rpx;
}

.date-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-bottom: 8rpx;
}

.date-value {
  font-size: 28rpx;
  font-weight: 500;
}

.range-divider {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* 快捷日期 */
.quick-dates {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.quick-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: 4rpx;
  font-size: 24rpx;
}

.quick-item:active {
  background: var(--color-primary);
  color: #FFFFFF;
}

/* 选择器列表 */
.picker-list {
  max-height: 60vh;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.picker-item:last-child {
  border-bottom: none;
}

.picker-item.active {
  color: var(--color-primary);
  font-weight: 500;
}

.item-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.item-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.item-name {
  font-size: 28rpx;
}
