/* pages/index/index.wxss */

.header {
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  color: #FFFFFF;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.header-month {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 32rpx;
}

.month-text {
  font-size: 28rpx;
  font-weight: 500;
  margin-right: 8rpx;
  color: #FFFFFF;
}

.month-arrow {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.8);
}

.header-action {
  display: flex;
  gap: 16rpx;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.icon-text {
  font-size: 32rpx;
  color: #FFFFFF;
}

.header-stats {
  display: flex;
  gap: 64rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.stat-amount {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  font-feature-settings: "tnum";
  color: #FFFFFF;
}

.stat-count {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
}

/* 日期分组 */
.date-group {
  margin-bottom: 24rpx;
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.date-text {
  font-size: 24rpx;
  color: var(--color-text-muted);
  font-weight: 500;
}

.date-total {
  font-size: 24rpx;
  color: var(--color-text-muted);
  font-feature-settings: "tnum";
}

/* 消费项 */
.expense-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--color-border-light);
  transition: all 0.2s ease;
}

.expense-item:active {
  background-color: var(--color-bg);
  transform: scale(0.98);
}

.expense-item:last-child {
  border-bottom: none;
}

.expense-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(108, 92, 231, 0.1) 0%, rgba(162, 155, 254, 0.1) 100%);
  border-radius: 20rpx;
  margin-right: 24rpx;
}

.icon-emoji {
  font-size: 40rpx;
}

.expense-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.expense-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.expense-category {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.expense-amount {
  font-size: 32rpx;
  font-weight: 700;
  font-feature-settings: "tnum";
  color: var(--color-text);
}

.expense-sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.expense-desc {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-right: 16rpx;
}

.expense-tags {
  display: flex;
  flex-wrap: wrap;
}

/* FAB按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(108, 92, 231, 0.4);
  z-index: 100;
  transition: all 0.2s ease;
}

.fab:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 60rpx;
  color: #FFFFFF;
  font-weight: 300;
}

/* 加载完成 */
.load-end {
  padding: 32rpx;
  text-align: center;
}

.load-end-text {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* 月份选择器 */
.month-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.month-picker {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
  padding-bottom: 80rpx;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.picker-title {
  font-size: 36rpx;
  font-weight: 600;
}

.picker-close {
  font-size: 36rpx;
  color: var(--color-text-muted);
  padding: 16rpx;
}

.picker-years {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.year-item {
  padding: 20rpx 40rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  font-size: 28rpx;
  transition: all 0.2s ease;
}

.year-item.active {
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%);
  color: #FFFFFF;
}

.picker-months {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.month-item {
  padding: 28rpx;
  text-align: center;
  background: var(--color-bg);
  border-radius: 12rpx;
  font-size: 28rpx;
  transition: all 0.2s ease;
}

.month-item.active {
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%);
  color: #FFFFFF;
}
