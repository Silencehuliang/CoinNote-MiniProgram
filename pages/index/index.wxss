/* pages/index/index.wxss - 遵循微信设计规范 */

/* 头部统计区域 */
.header {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.header-month {
  display: flex;
  align-items: center;
  padding: var(--spacing-xs) var(--spacing-sm);
  background-color: var(--color-bg-page);
  border-radius: var(--radius-sm);
}

.month-text {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  margin-right: var(--spacing-xs);
}

.month-arrow {
  font-size: var(--font-size-xxs);
  color: var(--color-text-secondary);
}

.header-action {
  display: flex;
  gap: var(--spacing-sm);
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-bg-page);
  border-radius: 50%;
}

.icon-btn:active {
  background-color: var(--color-bg-hover);
}

.icon-text {
  font-size: var(--font-size-lg);
  color: var(--color-text-primary);
}

.header-stats {
  display: flex;
  gap: var(--spacing-xl);
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xs);
}

.stat-amount {
  font-size: 56rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  font-feature-settings: "tnum";
}

.stat-count {
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-regular);
}

/* 日期分组 */
.date-group {
  margin-bottom: var(--spacing-md);
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) 0;
}

.date-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
}

.date-total {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  font-feature-settings: "tnum";
}

/* 消费列表项 */
.date-items {
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.expense-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  background-color: var(--color-bg-card);
  position: relative;
}

.expense-item::after {
  content: '';
  position: absolute;
  left: 120rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background-color: var(--color-divider);
}

.expense-item:last-child::after {
  display: none;
}

.expense-item:active {
  background-color: var(--color-bg-hover);
}

.expense-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-bg-page);
  border-radius: var(--radius-md);
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.icon-emoji {
  font-size: 40rpx;
}

.expense-info {
  flex: 1;
  min-width: 0;
}

.expense-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-xs);
}

.expense-category {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.expense-amount {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  font-feature-settings: "tnum";
}

.expense-sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.expense-desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-right: var(--spacing-sm);
}

.expense-tags {
  display: flex;
  flex-wrap: wrap;
}

.expense-user {
  font-size: var(--font-size-xxs);
  color: var(--color-text-secondary);
  padding: 2rpx var(--spacing-xs);
  background-color: var(--color-bg-page);
  border-radius: var(--radius-sm);
}

/* FAB 浮动按钮 */
.fab {
  position: fixed;
  right: var(--spacing-lg);
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  background-color: var(--color-brand);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
  z-index: 100;
}

.fab:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 56rpx;
  color: var(--white);
  font-weight: var(--font-weight-regular);
}

/* 加载更多 */
.load-end {
  padding: var(--spacing-lg);
  text-align: center;
}

.load-end-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

/* 月份选择器 */
.month-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.month-picker {
  width: 100%;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: var(--spacing-lg);
  padding-bottom: calc(var(--spacing-lg) + env(safe-area-inset-bottom));
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.picker-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.picker-close {
  font-size: var(--font-size-lg);
  color: var(--color-text-secondary);
  padding: var(--spacing-sm);
}

.picker-years {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-lg);
}

.year-item {
  padding: var(--spacing-sm) var(--spacing-lg);
  background-color: var(--color-bg-page);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  color: var(--color-text-regular);
}

.year-item:active {
  background-color: var(--color-bg-hover);
}

.year-item.active {
  background-color: var(--color-brand);
  color: var(--white);
}

.picker-months {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-lg);
}

.month-item {
  padding: var(--spacing-md);
  text-align: center;
  background-color: var(--color-bg-page);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  color: var(--color-text-regular);
}

.month-item:active {
  background-color: var(--color-bg-hover);
}

.month-item.active {
  background-color: var(--color-brand);
  color: var(--white);
}
