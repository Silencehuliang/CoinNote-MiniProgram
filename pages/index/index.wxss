/* pages/index/index.wxss - 精致奢华风格 */

/* 头部统计区域 */
.header {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--space-5) var(--space-4);
  margin-bottom: var(--space-4);
  border: 1rpx solid var(--color-border);
  position: relative;
  overflow: hidden;
}

/* 金色渐变装饰线 */
.header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, var(--color-accent-dark) 0%, var(--color-accent) 50%, var(--color-accent-dark) 100%);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-5);
}

.header-month {
  display: flex;
  align-items: center;
  padding: var(--space-1) var(--space-3);
  background: var(--color-bg-input);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
}

.month-text {
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  color: var(--color-text-primary);
  margin-right: var(--space-1);
}

.month-arrow {
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
}

.header-action {
  display: flex;
  gap: var(--space-2);
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-input);
  border-radius: 50%;
  border: 1rpx solid var(--color-border);
  transition: all var(--transition-fast);
}

.icon-btn:active {
  background: var(--color-bg-elevated);
  border-color: var(--color-accent);
}

.icon-text {
  font-size: var(--text-lg);
  color: var(--color-text-primary);
}

.header-stats {
  display: flex;
  gap: var(--space-6);
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-label {
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--space-1);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.stat-amount {
  font-size: 56rpx;
  font-weight: var(--weight-light);
  color: var(--color-accent);
  font-feature-settings: "tnum";
  letter-spacing: -1rpx;
}

.stat-count {
  font-size: var(--text-base);
  color: var(--color-text-tertiary);
  font-weight: var(--weight-light);
  margin-top: var(--space-1);
}

/* 日期分组 */
.date-group {
  margin-bottom: var(--space-4);
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-2) 0;
}

.date-text {
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
  font-weight: var(--weight-medium);
  letter-spacing: 1rpx;
}

.date-total {
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
  font-feature-settings: "tnum";
}

/* 消费列表项 */
.date-items {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1rpx solid var(--color-border);
}

.expense-item {
  display: flex;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  position: relative;
  transition: background var(--transition-fast);
}

.expense-item::after {
  content: '';
  position: absolute;
  left: 120rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--color-divider);
}

.expense-item:last-child::after {
  display: none;
}

.expense-item:active {
  background: var(--color-bg-elevated);
}

.expense-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-input);
  border-radius: var(--radius-md);
  margin-right: var(--space-3);
  flex-shrink: 0;
  border: 1rpx solid var(--color-border);
}

.icon-emoji {
  font-size: 36rpx;
}

.expense-info {
  flex: 1;
  min-width: 0;
}

.expense-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-1);
}

.expense-category {
  font-size: var(--text-base);
  font-weight: var(--weight-medium);
  color: var(--color-text-primary);
}

.expense-amount {
  font-size: var(--text-base);
  font-weight: var(--weight-medium);
  color: var(--color-text-primary);
  font-feature-settings: "tnum";
}

.expense-sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.expense-desc {
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
  margin-right: var(--space-2);
}

.expense-tags {
  display: flex;
  flex-wrap: wrap;
}

.expense-user {
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
  padding: 2rpx var(--space-1);
  background: var(--color-bg-input);
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
}

/* FAB 浮动按钮 */
.fab {
  position: fixed;
  right: var(--space-4);
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(201, 169, 110, 0.4);
  z-index: 100;
  transition: all var(--transition-fast);
}

.fab:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(201, 169, 110, 0.3);
}

.fab-icon {
  font-size: 56rpx;
  color: #000000;
  font-weight: var(--weight-light);
}

/* 加载更多 */
.load-end {
  padding: var(--space-5);
  text-align: center;
}

.load-end-text {
  font-size: var(--text-xs);
  color: var(--color-text-disabled);
  letter-spacing: 2rpx;
}

/* 月份选择器 */
.month-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10px);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.month-picker {
  width: 100%;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: var(--space-5);
  padding-bottom: calc(var(--space-5) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-5);
}

.picker-title {
  font-size: var(--text-lg);
  font-weight: var(--weight-medium);
  color: var(--color-text-primary);
}

.picker-close {
  font-size: var(--text-lg);
  color: var(--color-text-tertiary);
  padding: var(--space-2);
}

.picker-years {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-5);
}

.year-item {
  padding: var(--space-2) var(--space-4);
  background: var(--color-bg-input);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
  transition: all var(--transition-fast);
}

.year-item:active {
  background: var(--color-bg-elevated);
}

.year-item.active {
  background: var(--color-accent);
  color: #000000;
  border-color: var(--color-accent);
}

.picker-months {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-2);
  margin-bottom: var(--space-5);
}

.month-item {
  padding: var(--space-3);
  text-align: center;
  background: var(--color-bg-input);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
  transition: all var(--transition-fast);
}

.month-item:active {
  background: var(--color-bg-elevated);
}

.month-item.active {
  background: var(--color-accent);
  color: #000000;
  border-color: var(--color-accent);
}
