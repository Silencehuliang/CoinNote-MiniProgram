/* pages/index/index.wxss - 温暖治愈风格 */

/* 头部统计区域 */
.header {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF5E6 100%);
  border-radius: var(--radius-xl);
  padding: var(--space-6) var(--space-5);
  margin-bottom: var(--space-5);
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
}

/* 可爱装饰圆点 */
.header::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 126, 95, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.header::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: -20rpx;
  width: 160rpx;
  height: 160rpx;
  background: radial-gradient(circle, rgba(136, 201, 161, 0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-5);
  position: relative;
  z-index: 1;
}

.header-month {
  display: flex;
  align-items: center;
  padding: var(--space-2) var(--space-4);
  background: var(--color-bg-card);
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-sm);
}

.month-text {
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
  margin-right: var(--space-1);
}

.month-arrow {
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
}

.header-action {
  display: flex;
  gap: var(--space-3);
}

.icon-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-card);
  border-radius: 50%;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-spring);
}

.icon-btn:active {
  transform: scale(0.9);
  box-shadow: var(--shadow-md);
}

.icon-text {
  font-size: var(--text-xl);
}

.header-stats {
  display: flex;
  gap: var(--space-7);
  position: relative;
  z-index: 1;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-label {
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--space-2);
  letter-spacing: 2rpx;
}

.stat-amount {
  font-size: 64rpx;
  font-weight: var(--weight-bold);
  color: var(--color-text-primary);
  font-feature-settings: "tnum";
  line-height: 1;
}

.stat-count {
  font-size: var(--text-sm);
  color: var(--color-text-tertiary);
  font-weight: var(--weight-normal);
  margin-top: var(--space-2);
}

/* 日期分组 */
.date-group {
  margin-bottom: var(--space-5);
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-2) var(--space-1);
}

.date-text {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  font-weight: var(--weight-semibold);
}

.date-total {
  font-size: var(--text-sm);
  color: var(--color-text-tertiary);
  font-feature-settings: "tnum";
}

/* 消费列表项 */
.date-items {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.expense-item {
  display: flex;
  align-items: center;
  padding: var(--space-4) var(--space-5);
  position: relative;
  transition: all var(--transition-fast);
}

.expense-item::after {
  content: '';
  position: absolute;
  left: 140rpx;
  right: var(--space-5);
  bottom: 0;
  height: 2rpx;
  background: var(--color-divider);
  border-radius: 1rpx;
}

.expense-item:last-child::after {
  display: none;
}

.expense-item:active {
  background: var(--color-bg-warm);
}

.expense-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-warm);
  border-radius: var(--radius-lg);
  margin-right: var(--space-4);
  flex-shrink: 0;
}

.icon-emoji {
  font-size: 40rpx;
}

.expense-info {
  flex: 1;
  min-width: 0;
}

.expense-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-1);
}

.expense-category {
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
}

.expense-amount {
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: var(--color-expense);
  font-feature-settings: "tnum";
}

.expense-amount--income {
  color: var(--color-income);
}

.expense-sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.expense-desc {
  font-size: var(--text-sm);
  color: var(--color-text-tertiary);
  margin-right: var(--space-2);
}

.expense-tags {
  display: flex;
  flex-wrap: wrap;
}

.expense-user {
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
  padding: 2rpx var(--space-2);
  background: var(--color-bg-warm);
  border-radius: var(--radius-pill);
}

/* FAB 浮动按钮 */
.fab {
  position: fixed;
  right: var(--space-5);
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  width: 128rpx;
  height: 128rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(255, 126, 95, 0.5);
  z-index: 100;
  transition: all var(--transition-spring);
}

.fab:active {
  transform: scale(0.9) rotate(90deg);
}

.fab-icon {
  font-size: 64rpx;
  color: #FFFFFF;
  font-weight: var(--weight-normal);
}

/* 加载更多 */
.load-end {
  padding: var(--space-6);
  text-align: center;
}

.load-end-text {
  font-size: var(--text-sm);
  color: var(--color-text-disabled);
}

/* 月份选择器 */
.month-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(74, 55, 40, 0.5);
  backdrop-filter: blur(10px);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.month-picker {
  width: 100%;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: var(--space-6);
  padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom));
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-6);
}

.picker-title {
  font-size: var(--text-xl);
  font-weight: var(--weight-semibold);
  color: var(--color-text-primary);
}

.picker-close {
  font-size: var(--text-xl);
  color: var(--color-text-tertiary);
  padding: var(--space-2);
}

.picker-years {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-bottom: var(--space-6);
}

.year-item {
  padding: var(--space-3) var(--space-5);
  background: var(--color-bg-warm);
  border-radius: var(--radius-pill);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  transition: all var(--transition-spring);
}

.year-item:active {
  transform: scale(0.95);
}

.year-item.active {
  background: var(--color-primary);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 126, 95, 0.35);
}

.picker-months {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-3);
  margin-bottom: var(--space-6);
}

.month-item {
  padding: var(--space-4);
  text-align: center;
  background: var(--color-bg-warm);
  border-radius: var(--radius-lg);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  transition: all var(--transition-spring);
}

.month-item:active {
  transform: scale(0.95);
}

.month-item.active {
  background: var(--color-primary);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 126, 95, 0.35);
}
