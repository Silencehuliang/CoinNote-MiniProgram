<!-- pages/family/index.wxml -->
<view class="container container--gray">
  <!-- 未加入家庭 -->
  <view class="no-family" wx:if="{{!familyInfo}}">
    <view class="empty">
      <text class="empty-icon">👨‍👩‍👧‍👦</text>
      <text class="empty-text">还没有加入家庭</text>
      <text class="empty-desc">创建或加入家庭，一起记录消费</text>
    </view>
    
    <view class="action-buttons">
      <view class="btn btn--primary btn--block" bindtap="createFamily">
        <text>创建家庭</text>
      </view>
      <view class="btn btn--secondary btn--block mt-lg" bindtap="joinFamily">
        <text>加入家庭</text>
      </view>
    </view>
  </view>

  <!-- 已加入家庭 -->
  <view class="family-content" wx:if="{{familyInfo}}">
    <!-- 家庭信息卡片 -->
    <view class="family-card card">
      <view class="family-header">
        <view class="family-info">
          <text class="family-name">{{familyInfo.name}}</text>
          <text class="family-count">{{familyInfo.members.length}}位成员</text>
        </view>
        <view class="family-actions">
          <view class="action-btn" bindtap="showInviteCode">
            <text class="action-icon">🔗</text>
            <text class="action-text">邀请</text>
          </view>
        </view>
      </view>
      
      <view class="invite-code-section">
        <text class="invite-label">邀请码</text>
        <view class="invite-code-box">
          <text class="invite-code">{{familyInfo.inviteCode}}</text>
          <view class="copy-btn" bindtap="copyInviteCode">
            <text>复制</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 成员列表 -->
    <view class="members-card card">
      <view class="section-header">
        <text class="section-title">家庭成员</text>
      </view>
      
      <view class="member-list">
        <view class="member-item" wx:for="{{familyInfo.members}}" wx:key="id">
          <view class="member-left">
            <image class="member-avatar" src="{{item.avatar || '/assets/default-avatar.png'}}" mode="aspectFill" />
            <view class="member-info">
              <text class="member-name">{{item.nickname}}</text>
              <text class="member-role" wx:if="{{item.id === familyInfo.ownerId}}">创建者</text>
            </view>
          </view>
          <view class="member-right">
            <text class="member-amount">¥{{item.totalAmount || '0.00'}}</text>
            <text class="member-count">{{item.totalCount || 0}}笔</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 家庭统计概览 -->
    <view class="stats-card card">
      <view class="section-header">
        <text class="section-title">本月概览</text>
      </view>
      
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-value">¥{{familyStats.totalAmount}}</text>
          <text class="stat-label">总支出</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{familyStats.totalCount}}</text>
          <text class="stat-label">总笔数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">¥{{familyStats.avgPerPerson}}</text>
          <text class="stat-label">人均</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">¥{{familyStats.dailyAvg}}</text>
          <text class="stat-label">日均</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-section">
      <view class="action-item" bindtap="refreshInviteCode">
        <text class="action-icon">🔄</text>
        <text class="action-text">刷新邀请码</text>
      </view>
      <view class="action-item danger" bindtap="leaveFamily">
        <text class="action-icon">🚪</text>
        <text class="action-text">退出家庭</text>
      </view>
    </view>
  </view>
</view>

<!-- 邀请码弹窗 -->
<view class="modal-mask" wx:if="{{showInviteModal}}" bindtap="hideInviteModal">
  <view class="modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">邀请家人</text>
      <text class="modal-close" bindtap="hideInviteModal">✕</text>
    </view>
    <view class="modal-body">
      <text class="modal-desc">分享邀请码给微信好友，对方在小程序中输入邀请码即可加入家庭</text>
      <view class="invite-code-display">
        <text class="code-text">{{familyInfo.inviteCode}}</text>
      </view>
      <button class="btn btn--primary btn--block" open-type="share">
        <text>分享给好友</text>
      </button>
    </view>
  </view>
</view>

<!-- 创建家庭弹窗 -->
<view class="modal-mask" wx:if="{{showCreateModal}}" bindtap="hideCreateModal">
  <view class="modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">创建家庭</text>
      <text class="modal-close" bindtap="hideCreateModal">✕</text>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">家庭名称</text>
        <input class="input" value="{{familyName}}" placeholder="请输入家庭名称" bindinput="onFamilyNameInput" />
      </view>
    </view>
    <view class="modal-footer">
      <view class="btn btn--primary btn--block" bindtap="confirmCreate">
        <text>创建</text>
      </view>
    </view>
  </view>
</view>

<!-- 加入家庭弹窗 -->
<view class="modal-mask" wx:if="{{showJoinModal}}" bindtap="hideJoinModal">
  <view class="modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title">加入家庭</text>
      <text class="modal-close" bindtap="hideJoinModal">✕</text>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">邀请码</text>
        <input class="input" value="{{inviteCode}}" placeholder="请输入邀请码" bindinput="onInviteCodeInput" />
      </view>
    </view>
    <view class="modal-footer">
      <view class="btn btn--primary btn--block" bindtap="confirmJoin">
        <text>加入</text>
      </view>
    </view>
  </view>
</view>
