/* pages/family/index.wxss */

/* 无家庭状态 */
.no-family {
  display: flex;
  flex-direction: column;
  min-height: 80vh;
}

.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.action-buttons {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

/* 家庭信息卡片 */
.family-card {
  margin-bottom: 24rpx;
}

.family-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.family-info {
  display: flex;
  flex-direction: column;
}

.family-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.family-count {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.family-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
}

.action-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.action-text {
  font-size: 20rpx;
  color: var(--color-text-muted);
}

/* 邀请码区域 */
.invite-code-section {
  padding: 24rpx;
  background: var(--color-bg);
  border-radius: 8rpx;
}

.invite-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-bottom: 12rpx;
  display: block;
}

.invite-code-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-code {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  font-feature-settings: "tnum";
}

.copy-btn {
  padding: 12rpx 24rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: 4rpx;
  font-size: 24rpx;
}

/* 成员列表 */
.members-card {
  margin-bottom: 24rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
}

.member-list {
  display: flex;
  flex-direction: column;
}

.member-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.member-item:last-child {
  border-bottom: none;
}

.member-left {
  display: flex;
  align-items: center;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.member-info {
  display: flex;
  flex-direction: column;
}

.member-name {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.member-role {
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.member-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.member-amount {
  font-size: 28rpx;
  font-weight: 500;
  font-feature-settings: "tnum";
  margin-bottom: 4rpx;
}

.member-count {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* 统计卡片 */
.stats-card {
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: var(--color-bg);
  border-radius: 8rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 500;
  font-feature-settings: "tnum";
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* 操作按钮 */
.action-section {
  margin-top: 40rpx;
  padding: 0 32rpx;
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  background: var(--color-bg-white);
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.action-item .action-icon {
  margin-right: 12rpx;
  margin-bottom: 0;
}

.action-item .action-text {
  font-size: 28rpx;
  color: var(--color-text);
}

.action-item.danger {
  border: 2rpx solid var(--color-danger);
}

.action-item.danger .action-text {
  color: var(--color-danger);
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 80%;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
}

.modal-close {
  font-size: 32rpx;
  color: var(--color-text-muted);
  padding: 8rpx;
}

.modal-body {
  padding: 32rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: var(--color-text-light);
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.modal-footer {
  padding: 24rpx 32rpx 32rpx;
}

/* 邀请码显示 */
.invite-code-display {
  display: flex;
  justify-content: center;
  padding: 40rpx;
  margin-bottom: 32rpx;
  background: var(--color-bg);
  border-radius: 8rpx;
}

.code-text {
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 12rpx;
  font-feature-settings: "tnum";
}
