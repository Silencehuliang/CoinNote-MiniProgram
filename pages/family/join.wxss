/* pages/family/join.wxss */

.join-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 64rpx;
}

.join-icon {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
  border-radius: 50%;
  margin-bottom: 48rpx;
}

.icon-text {
  font-size: 80rpx;
}

.join-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}

.join-title {
  font-size: 28rpx;
  color: var(--color-text-muted);
  margin-bottom: 16rpx;
}

.family-name {
  font-size: 40rpx;
  font-weight: 600;
}

.login-section,
.join-section {
  width: 100%;
}

.login-desc {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-light);
  margin-bottom: 32rpx;
}

.mt-lg {
  margin-top: 32rpx;
}
