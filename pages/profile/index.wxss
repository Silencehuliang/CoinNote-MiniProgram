/* pages/profile/index.wxss */

/* 用户卡片 */
.user-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 32rpx;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.user-family {
  font-size: 24rpx;
  color: var(--color-text-light);
}

.user-id {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.edit-btn {
  padding: 12rpx 24rpx;
  background: var(--color-bg);
  border-radius: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-light);
}

/* 数据统计 */
.stats-card {
  margin-top: 24rpx;
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 28rpx;
  font-weight: 500;
}

.stats-period {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: var(--color-bg);
  border-radius: 8rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 500;
  font-feature-settings: "tnum";
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* 菜单列表 */
.menu-card {
  margin-top: 24rpx;
  padding: 0;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 24rpx;
}

.menu-text {
  font-size: 28rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--color-text-muted);
}

.menu-value {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* 退出登录 */
.logout-section {
  margin-top: 64rpx;
  padding: 0 32rpx;
}

/* 版本号 */
.version {
  text-align: center;
  padding: 64rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 80%;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
}

.modal-close {
  font-size: 32rpx;
  color: var(--color-text-muted);
  padding: 8rpx;
}

.modal-body {
  padding: 32rpx;
}

.modal-footer {
  padding: 24rpx 32rpx 32rpx;
}

/* 关于弹窗 */
.about-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.about-logo {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.logo-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.about-desc {
  font-size: 28rpx;
  color: var(--color-text-light);
  margin-bottom: 12rpx;
}

.about-version {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: 32rpx;
}

.about-features {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-item {
  font-size: 26rpx;
  color: var(--color-text-light);
  line-height: 1.6;
}
